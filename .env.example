# Скопируйте в .env и заполните. Сгенерировать секрет: openssl rand -hex 32
SECRET_KEY=
# Первый администратор создаётся при старте, если в БД нет пользователей.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

POSTGRES_DB=gosdoc
POSTGRES_USER=gosdoc
# Только буквы и цифры: пароль подставляется в DATABASE_URL.
POSTGRES_PASSWORD=

HTTP_PORT=8080
# true, если сайт открывается по HTTPS (через обратный прокси).
COOKIE_SECURE=false
SESSION_TTL_MINUTES=720

# Любой OpenAI-совместимый сервер: Ollama, vLLM, llama.cpp server, LM Studio, облачный провайдер.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local
LLM_MODEL=qwen3:14b
LLM_TEMPERATURE=0.2
# Доп. поля запроса. Для Qwen3 в Ollama отключает режим рассуждений — ответы в разы быстрее.
LLM_EXTRA_BODY='{"reasoning_effort":"none"}'

# Для make up-prod: откуда брать готовые образы.
IMAGE_PREFIX=ghcr.io/fgeeha/light-gosdoc-assistant
TAG=latest
# COMPOSE_PROFILES=ollama
