# Шаблон: при старте контейнера ${TRUSTED_PROXY} подставляется из окружения (envsubst образа nginx).
# Перебор паролей: не более 10 попыток входа в минуту с одного адреса
# (плюс блокировка учётной записи в самом приложении).
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
# Запуски модели и загрузки (POST /api/tools/…) с одного адреса: не больше 4 одновременно и
# 30 в минуту. GET (опрос статуса, образцы) не считается: пустой ключ nginx не учитывает.
map $request_method $tools_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_conn_zone $tools_limit_key zone=tools_conn:10m;
limit_req_zone $tools_limit_key zone=tools:10m rate=30r/m;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 12m;
    server_tokens off;

    # Настоящий адрес клиента за внешним обратным прокси — иначе лимит входа общий на всех.
    # TRUSTED_PROXY — адрес или подсеть прокси; заголовку от остальных не доверяем.
    set_real_ip_from ${TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/proxy-backend.inc;
        include /etc/nginx/security-headers.inc;
    }

    location /api/tools/ {
        limit_conn tools_conn 4;
        limit_conn_status 429;
        limit_req zone=tools burst=20 nodelay;
        limit_req_status 429;
        include /etc/nginx/proxy-backend.inc;
        # Потоковые ответы модели (SSE) — без буферизации и с долгим таймаутом.
        proxy_buffering off;
        proxy_read_timeout 900s;
        include /etc/nginx/security-headers.inc;
    }

    location /api/ {
        include /etc/nginx/proxy-backend.inc;
        include /etc/nginx/security-headers.inc;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.inc;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.inc;
    }
}
